global:
  resolve_timeout: 30s

route:
  receiver: aegisops-webhook
  group_by: ["alertname", "service", "namespace", "cluster"]
  group_wait: 2s
  group_interval: 5s
  repeat_interval: 30s

receivers:
  - name: aegisops-webhook
    webhook_configs:
      - url: http://host.docker.internal:58000/api/v1/webhooks/alertmanager
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: __AEGISOPS_WEBHOOK_BEARER_TOKEN__

# ==============================================================================
# AegisOps Environment Configuration Example
# Copy to `.env` or run `.\scripts\setup.ps1` to generate local `.env` with
# cryptographically random secrets (never commit `.env` to git).
# ==============================================================================

# --- Environment ---
AEGISOPS_ENV=development
AEGISOPS_LOG_LEVEL=INFO
AEGISOPS_API_HOST=127.0.0.1
AEGISOPS_API_PORT=58000
AEGISOPS_FRONTEND_ORIGIN=http://127.0.0.1:55173
AEGISOPS_CORS_ORIGINS=["http://127.0.0.1:55173","http://localhost:55173"]

# --- Control-Plane Database (PostgreSQL 16 + pgvector on host port 55432) ---
POSTGRES_USER=aegisops
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=aegisops
POSTGRES_PORT=55432
AEGISOPS_DATABASE_URL=postgresql+asyncpg://aegisops:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:55432/aegisops

# --- Control-Plane Redis (host port 56379) ---
REDIS_PORT=56379
AEGISOPS_REDIS_URL=redis://127.0.0.1:56379/0
AEGISOPS_LOCK_TTL_MS=30000

# --- Security & Cryptography (Required: generated locally by scripts/setup.ps1) ---
AEGISOPS_WEBHOOK_HMAC_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET
AEGISOPS_WEBHOOK_BEARER_TOKEN=CHANGE_ME_WEBHOOK_BEARER_TOKEN
# Fernet URL-safe base64 32-byte key (generated by setup.ps1)
AEGISOPS_TOTP_ENCRYPTION_KEY=CHANGE_ME_FERNET_TOTP_KEY
AEGISOPS_SESSION_SECRET=CHANGE_ME_SESSION_SECRET
AEGISOPS_WEBHOOK_MAX_BYTES=262144
AEGISOPS_WEBHOOK_RATE_LIMIT_PER_MIN=120

# --- Local Ollama AI Server ---
AEGISOPS_OLLAMA_BASE_URL=http://127.0.0.1:11434
AEGISOPS_EMBEDDING_MODEL=nomic-embed-text:latest
AEGISOPS_EMBEDDING_MODEL_DIGEST=sha256:0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
AEGISOPS_EMBEDDING_DIMENSIONS=768
AEGISOPS_CHAT_MODEL=llama3.2:3b
AEGISOPS_SIMILARITY_THRESHOLD=0.78
AEGISOPS_OLLAMA_TIMEOUT_SECONDS=45.0

# --- Kubernetes Target Allowlist (kind-aegisops-local) ---
AEGISOPS_K8S_CONTEXT=kind-aegisops-local
AEGISOPS_K8S_ALLOWED_CONTEXTS=["kind-aegisops-local"]
AEGISOPS_K8S_ALLOWED_NAMESPACES=["aegisops-healthcare"]
AEGISOPS_K8S_DRY_RUN=false

# --- Recovery Watchdog ---
AEGISOPS_RECOVERY_WINDOW_SECONDS=60
AEGISOPS_RECOVERY_POLL_INTERVAL_SECONDS=5
AEGISOPS_PROMETHEUS_URL=http://127.0.0.1:59090

# --- Keycloak OIDC (host port 58080) ---
KEYCLOAK_PORT=58080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_DEMO_USER_PASSWORD=CHANGE_ME_KEYCLOAK_DEMO_USER_PASSWORD
AEGISOPS_OIDC_ISSUER=http://127.0.0.1:58080/realms/aegisops
AEGISOPS_OIDC_JWKS_URL=http://127.0.0.1:58080/realms/aegisops/protocol/openid-connect/certs
AEGISOPS_OIDC_TOKEN_URL=http://127.0.0.1:58080/realms/aegisops/protocol/openid-connect/token
AEGISOPS_OIDC_CLIENT_ID=aegisops-console
AEGISOPS_OIDC_AUDIENCE=aegisops-api
AEGISOPS_AUTH_REQUIRED=true

# --- Langfuse Local LLM Observability (host port 53000) ---
LANGFUSE_PORT=53000
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_LANGFUSE_NEXTAUTH_SECRET
LANGFUSE_SALT=CHANGE_ME_LANGFUSE_SALT
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_LANGFUSE_HEX_64_KEY
LANGFUSE_PUBLIC_KEY=pk-lf-aegisops-local
LANGFUSE_SECRET_KEY=sk-lf-aegisops-local
LANGFUSE_HOST=http://127.0.0.1:53000
AEGISOPS_LANGFUSE_ENABLED=false

# --- OpenTelemetry & Demo Service Ports ---
OTEL_GRPC_PORT=55317
OTEL_HTTP_PORT=55318
PROMETHEUS_PORT=59090
ALERTMANAGER_PORT=59093
DEMO_ELIGIBILITY_PORT=58081
DEMO_CLAIMS_PORT=58082
DEMO_PROVIDER_PORT=58083
DEMO_INTERNAL_FAULT_TOKEN=CHANGE_ME_DEMO_FAULT_TOKEN
